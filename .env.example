# ---- Rad environment template ----
# Copy to .env.local and fill in. Never commit real values.

# Anthropic (Rad's brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_SOCIAL_CHANNEL=#social

# ---- Confluence Cloud (read-only) ----
CONFLUENCE_BASE_URL=https://radixconnect.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=

# ---- Google Drive (read-only) ----
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_PEOPLE_SHEET_ID=

# ---- App ----
APP_BASE_URL=http://localhost:3023
CRON_SECRET=
# Rad roles (comma-separated emails). admin = full control; manager = day-to-day.
# Both receive test notifications.
RAD_ADMIN_EMAILS=
RAD_MANAGER_EMAILS=
