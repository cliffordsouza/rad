<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.radix.rad-worker</string>

  <!-- caffeinate -i keeps the Mac from idle-sleeping while RAD runs -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/cliffy/.local/bin/node</string>
    <string>worker/rad-socket.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/cliffy/dev/rad</string>

  <!-- start at login, and restart whenever it exits (crash, kill, watchdog) -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/tmp/rad-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rad-worker.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/cliffy/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
